import Yau.Geometry.Calculus

open scoped InnerProductSpace

noncomputable section

namespace Yau.NodeProofs.P03Aux

/-- Compatibility of the actual real and complex Euclidean inner products. -/
theorem complexVector_real_inner {n : ℕ} (z v : ComplexVector n) :
    inner ℝ z v = (inner ℂ z v).re := by
  simp only [PiLp.inner_apply, Complex.inner, RCLike.inner_apply, Complex.re_sum]

/-- Cauchy--Schwarz on the actual real plane generated by a complex vector. -/
theorem complexVector_inner_line_bound {n : ℕ} (z v : ComplexVector n) :
    (inner ℝ z v) ^ 2 + (inner ℝ z (Complex.I • v)) ^ 2 ≤
      ‖z‖ ^ 2 * ‖v‖ ^ 2 := by
  rw [complexVector_real_inner, complexVector_real_inner, inner_smul_right]
  simp only [Complex.mul_re, Complex.I_re, Complex.I_im, zero_mul, one_mul,
    zero_sub, neg_sq]
  calc
    (inner ℂ z v).re ^ 2 + (inner ℂ z v).im ^ 2 = ‖inner ℂ z v‖ ^ 2 := by
      rw [Complex.sq_norm, Complex.normSq_apply]
      ring
    _ ≤ (‖z‖ * ‖v‖) ^ 2 := by
      exact (sq_le_sq₀ (norm_nonneg _) (mul_nonneg (norm_nonneg _) (norm_nonneg _))).mpr
        (norm_inner_le_norm z v)
    _ = ‖z‖ ^ 2 * ‖v‖ ^ 2 := mul_pow _ _ _

end Yau.NodeProofs.P03Aux
