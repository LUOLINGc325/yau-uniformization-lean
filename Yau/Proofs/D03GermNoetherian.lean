import Yau.Proofs.D03Germ

noncomputable section

open Filter Topology

namespace Yau.Proofs.D03Aux

/-- The order is independent of the chosen analytic representative. -/
def germOrder (g : AnalyticGerm) : ℕ∞ := analyticOrderAt (analyticRepresentative g) 0

theorem germOrder_ofAnalytic (f : ℂ → ℂ) (hf : AnalyticAt ℂ f 0) :
    germOrder (ofAnalytic f hf) = analyticOrderAt f 0 := by
  apply analyticOrderAt_congr
  apply (ofAnalytic_eq_iff _ _).mp
  exact ofAnalytic_representative _

@[simp]
theorem germOrder_eq_top_iff (g : AnalyticGerm) : germOrder g = ⊤ ↔ g = 0 := by
  rw [germOrder, analyticOrderAt_eq_top]
  exact ((ofAnalytic_eq_iff (analyticRepresentative_analytic g) analyticAt_const).symm.trans
    (by rw [ofAnalytic_representative]; rfl))

/-- Every ideal is generated by an element of minimal finite coordinate order. -/
instance : IsPrincipalIdealRing AnalyticGerm where
  principal I := by
    classical
    by_cases hI : I = ⊥
    · subst I
      infer_instance
    obtain ⟨g, hg, hg0⟩ := I.ne_bot_iff.mp hI
    obtain ⟨d, u, hu, hgu⟩ := exists_pow_mul_unit g hg0
    let P : ℕ → Prop := fun k => ∃ v : AnalyticGerm, IsUnit v ∧ zGerm ^ k * v ∈ I
    have hP : ∃ k, P k := ⟨d, u, hu, hgu ▸ hg⟩
    let k := Nat.find hP
    obtain ⟨v, hv, hvk⟩ := Nat.find_spec hP
    refine ⟨⟨zGerm ^ k * v, ?_⟩⟩
    symm
    apply le_antisymm
    · exact Ideal.span_le.mpr (Set.singleton_subset_iff.mpr hvk)
    · intro h hh
      rw [Ideal.mem_span_singleton]
      by_cases h0 : h = 0
      · exact h0 ▸ dvd_zero _
      obtain ⟨e, w, hw, hhe⟩ := exists_pow_mul_unit h h0
      have hke : k ≤ e := Nat.find_min' hP ⟨w, hw, hhe ▸ hh⟩
      obtain ⟨iv, hiv⟩ := isUnit_iff_exists_inv.mp hv
      refine ⟨zGerm ^ (e - k) * w * iv, ?_⟩
      calc
        h = zGerm ^ e * w := hhe
        _ = zGerm ^ k * zGerm ^ (e - k) * w := by
          rw [← pow_add, Nat.add_sub_of_le hke]
        _ = (zGerm ^ k * v) * (zGerm ^ (e - k) * w * iv) := by
          calc
            _ = zGerm ^ k * (zGerm ^ (e - k) * w) * (v * iv) := by rw [hiv, mul_one, mul_assoc]
            _ = _ := by ring

/-- Principal ideals imply the Noetherian hypothesis required by L25. -/
theorem analyticGerm_isNoetherian : IsNoetherianRing AnalyticGerm := inferInstance

/-- The maximal ideal is generated by the actual coordinate germ. -/
theorem germMaximalIdeal_eq_span : germMaximalIdeal = Ideal.span {zGerm} := by
  apply le_antisymm
  · intro g hg
    by_cases hg0 : g = 0
    · simpa [hg0] using (Submodule.zero_mem (Ideal.span {zGerm}))
    obtain ⟨d, u, hu, hgu⟩ := exists_pow_mul_unit g hg0
    have hd : d ≠ 0 := by
      intro hd
      have hgu' : g = u := by simpa [hd] using hgu
      have hval : germValue g = 0 := hg
      exact ((isUnit_iff_germValue_ne_zero u).mp hu) (hgu' ▸ hval)
    obtain ⟨e, rfl⟩ := Nat.exists_eq_succ_of_ne_zero hd
    rw [Ideal.mem_span_singleton]
    refine ⟨zGerm ^ e * u, ?_⟩
    rw [hgu, pow_succ]
    ring
  · apply Ideal.span_le.mpr
    rw [Set.singleton_subset_iff]
    exact germValue_zGerm

end Yau.Proofs.D03Aux
